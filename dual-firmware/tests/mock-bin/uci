#!/usr/bin/env bash

set -Eeuo pipefail

: "${MOCK_UCI_STATE:?MOCK_UCI_STATE is required}"
touch "$MOCK_UCI_STATE"

quiet=0
if [[ ${1:-} == '-q' ]]; then
	quiet=1
	shift
fi

command=${1:-}
shift || true

get_value() {
	local key=$1
	awk -F= -v key="$key" '$1 == key { value=$0; sub(/^[^=]*=/, "", value); print value; exit }' "$MOCK_UCI_STATE"
}

case "$command" in
	get)
		value=$(get_value "$1")
		if [[ -n "$value" ]]; then
			printf '%s\n' "$value"
		elif [[ $quiet -eq 0 ]]; then
			echo "uci: Entry not found" >&2
			exit 1
		else
			exit 1
		fi
		;;
	set)
		assignment=$1
		key=${assignment%%=*}
		value=${assignment#*=}
		tmp=$(mktemp)
		awk -F= -v key="$key" '$1 != key' "$MOCK_UCI_STATE" >"$tmp"
		printf '%s=%s\n' "$key" "$value" >>"$tmp"
		mv "$tmp" "$MOCK_UCI_STATE"
		;;
	add_list)
		assignment=$1
		key=${assignment%%=*}
		value=${assignment#*=}
		printf '%s=%s\n' "$key" "$value" >>"$MOCK_UCI_STATE"
		;;
	delete)
		key=$1
		tmp=$(mktemp)
		awk -F= -v key="$key" '$1 != key && index($1, key ".") != 1' "$MOCK_UCI_STATE" >"$tmp"
		mv "$tmp" "$MOCK_UCI_STATE"
		;;
	show)
		package=${1:-}
		if [[ -n "$package" ]]; then
			awk -F= -v prefix="$package." 'index($1, prefix) == 1' "$MOCK_UCI_STATE"
		else
			cat "$MOCK_UCI_STATE"
		fi
		;;
	commit)
		;;
	*)
		echo "unsupported mock uci command: $command" >&2
		exit 2
		;;
esac
